DATABASE_PATH=./data/control-center.sqlite
AI_PROVIDER=demo
ANALYTICS_PROVIDER=demo
PUBLISH_PROVIDER=demo
MONTHLY_BUDGET_USD=50
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional Google Gemini API configuration (AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional Pexels API key for stock photo & video enhancement
PEXELS_API_KEY=
# Free neural voice; no API key required. Requires internet during media generation.
FREE_TTS_VOICE=en-US-AriaNeural
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
YOUTUBE_TOKEN_ENCRYPTION_KEY=
